#!/usr/bin/env python3
"""StrandMD post-MD analysis — dynamics and guided engineering.

After your GROMACS run finishes, run this against md.xtc + a topology
file (.tpr, .gro, or .pdb).

Usage (prefer .gro — text-based, never version-locked):
    python analyze.py --top system.gro --xtc md.xtc -o analysis/

If you pass a .tpr and MDAnalysis can't read its version (the GROMACS
team bumps the format faster than MDAnalysis tracks), the script will
auto-fall-back to system.gro or system.pdb in the same directory.

Optionally pass an engineering objective generated by the StrandMD web app:

    python analyze.py --top system.gro --xtc md.xtc -o analysis/ \\
        --engineering-config engineering_config.json

Outputs a small results.json + figures/ folder. Guided runs also write
engineering.json with dynamic residue/nucleotide interaction fingerprints.

Requires:
    MDAnalysis>=2.7, matplotlib, numpy.
"""
from __future__ import annotations
import argparse
import json
import sys
from collections import defaultdict
from pathlib import Path

import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import MDAnalysis as mda
from MDAnalysis.analysis import rms, align
from MDAnalysis.lib.distances import capped_distance


# Discard the first 20% of frames as equilibration (standard practice).
EQUIL_FRAC = 0.20


def _load_universe(top: Path, xtc: Path) -> mda.Universe:
    """Build a Universe from topology + trajectory, with two automatic
    rescues:

    1. **Unreadable .tpr** (tpx version newer than MDAnalysis tracks)
       → fall back to md_solute.gro / system.gro / system_solvated.pdb.
    2. **Atom-count mismatch** (topology includes water, trajectory
       was water-stripped) → fall back to md_solute.gro / system.gro /
       md.gro that match the trajectory.
    """
    candidates = [top]
    for name in ("md_solute.gro", "system.gro", "system_solvated.pdb", "system.pdb"):
        c = top.parent / name
        if c.exists() and c != top:
            candidates.append(c)

    last_error: Exception | None = None
    for cand in candidates:
        try:
            u = mda.Universe(str(cand), str(xtc))
            if cand is not top:
                print(f"⤴ used fallback topology {cand.name}", file=sys.stderr)
            return u
        except (NotImplementedError, ValueError) as e:
            msg = str(e).lower()
            recoverable = (
                "tpx version" in msg
                or "not support" in msg
                or "same number of atoms" in msg
                or "atom" in msg and "match" in msg
            )
            print(f"⚠ {cand.name}: {e}", file=sys.stderr)
            last_error = e
            if not recoverable:
                raise
            continue

    raise RuntimeError(
        f"All topology candidates failed. Tried: {[c.name for c in candidates]}.\n"
        f"Last error: {last_error}\n"
        f"Fix: cd to the bundle dir and run\n"
        f"  echo 'System' | gmx trjconv -s md.tpr -f md.xtc "
        f"-o md_solute.gro -dump 0\n"
        f"then re-run analyze.py with --top md_solute.gro."
    ) from last_error


def _residue_dict(atom) -> dict:
    return {
        "segid": str(atom.segid or ""),
        "resid": int(atom.resid),
        "resname": str(atom.resname),
    }


def _residue_token(atom) -> str:
    return f"{str(atom.segid or '_')}:{int(atom.resid)}"


def _is_o2prime(atom_name: str) -> bool:
    return atom_name.upper().replace("*", "'") in {"O2'", "O2"}


def _molecule_kind(resname: str) -> str:
    name = resname.upper().strip()
    protein = {
        "ALA", "ARG", "ASN", "ASP", "CYS", "GLN", "GLU", "GLY", "HIS",
        "HID", "HIE", "HIP", "ILE", "LEU", "LYS", "MET", "PHE", "PRO",
        "SER", "THR", "TRP", "TYR", "VAL",
    }
    dna = {"DA", "DT", "DG", "DC", "DA3", "DT3", "DG3", "DC3", "DA5", "DT5", "DG5", "DC5"}
    rna = {"A", "U", "G", "C", "RA", "RU", "RG", "RC", "A3", "U3", "G3", "C3", "A5", "U5", "G5", "C5"}
    if name in protein:
        return "protein"
    if name in dna:
        return "dna"
    if name in rna:
        return "rna"
    return "other"


def _topology_index(universe: mda.Universe) -> dict:
    """Return protein/nucleic residue blocks for building region selections."""
    residues = []
    for residue in universe.residues:
        kind = _molecule_kind(str(residue.resname))
        if kind == "other":
            continue
        residues.append(
            {
                "segid": str(residue.segid or "_"),
                "resid": int(residue.resid),
                "resname": str(residue.resname),
                "kind": kind,
            }
        )

    blocks = []
    for residue in residues:
        if (
            blocks
            and blocks[-1]["segid"] == residue["segid"]
            and blocks[-1]["kind"] == residue["kind"]
            and residue["resid"] == blocks[-1]["end_resid"] + 1
        ):
            blocks[-1]["end_resid"] = residue["resid"]
            blocks[-1]["residue_count"] += 1
        else:
            segid_clause = (
                f"segid {residue['segid']} and " if residue["segid"] != "_" else ""
            )
            kind_clause = (
                ""
                if segid_clause
                else "protein and "
                if residue["kind"] == "protein"
                else "nucleic and "
            )
            blocks.append(
                {
                    "segid": residue["segid"],
                    "kind": residue["kind"],
                    "start_resid": residue["resid"],
                    "end_resid": residue["resid"],
                    "residue_count": 1,
                    "selection_hint": (
                        f"{segid_clause}{kind_clause}resid "
                        f"{residue['resid']}:{residue['resid']}"
                    ),
                }
            )
    for block in blocks:
        segid_clause = f"segid {block['segid']} and " if block["segid"] != "_" else ""
        kind_clause = (
            ""
            if segid_clause
            else "protein and "
            if block["kind"] == "protein"
            else "nucleic and "
        )
        block["selection_hint"] = (
            f"{segid_clause}{kind_clause}resid "
            f"{block['start_resid']}:{block['end_resid']}"
        )
    return {
        "schema_version": 1,
        "note": (
            "Protein/nucleic residues only. Use selection_hint as a starting point; "
            "split handle, spacer, target, PAM, or other functional regions by resid."
        ),
        "blocks": blocks,
        "residues": residues,
    }


def _engineering_fingerprints(
    universe: mda.Universe,
    config: dict,
    *,
    start: int,
    source_label: str,
) -> dict:
    """Calculate streaming residue/nucleotide contact fingerprints.

    Atom-pair contacts are deduplicated per protein residue, nucleotide, region,
    and frame before occupancy is calculated.
    """
    protein_selection = str(config.get("protein_selection", "protein"))
    protein = universe.select_atoms(f"({protein_selection}) and not name H*")
    if len(protein) == 0:
        raise ValueError(f"protein selection matched no atoms: {protein_selection}")

    region_groups = []
    for region in config.get("regions", []):
        selection = str(region["selection"])
        atoms = universe.select_atoms(f"({selection}) and not name H*")
        if len(atoms) == 0:
            raise ValueError(
                f"region {region['region_id']!r} selection matched no atoms: {selection}"
            )
        region_groups.append((region, atoms))
    if not region_groups:
        raise ValueError("engineering config contains no regions")

    protein_residues = [_residue_dict(atom) for atom in protein]
    states: dict[tuple[str, str], dict] = {}
    analyzed_frames = 0
    for ts in universe.trajectory[start:]:
        # (protein token, region id, nucleotide token) -> contact information
        frame_pairs: dict[tuple[str, str, str], dict] = {}
        box = ts.dimensions if ts.dimensions is not None and ts.dimensions.size >= 3 else None
        for region, region_atoms in region_groups:
            atom_pairs, distances = capped_distance(
                protein.positions,
                region_atoms.positions,
                max_cutoff=float(region.get("cutoff_A", 4.0)),
                box=box,
                return_distances=True,
            )
            for (protein_index, region_index), distance in zip(atom_pairs, distances):
                protein_index = int(protein_index)
                region_index = int(region_index)
                protein_atom = protein[protein_index]
                region_atom = region_atoms[region_index]
                protein_token = _residue_token(protein_atom)
                nucleotide_token = _residue_token(region_atom)
                pair_key = (protein_token, str(region["region_id"]), nucleotide_token)
                existing = frame_pairs.get(pair_key)
                o2prime = _is_o2prime(str(region_atom.name))
                if existing is None:
                    frame_pairs[pair_key] = {
                        "protein": protein_residues[protein_index],
                        "nucleotide": _residue_dict(region_atom),
                        "distance": float(distance),
                        "o2prime": o2prime,
                    }
                else:
                    existing["distance"] = min(existing["distance"], float(distance))
                    existing["o2prime"] = existing["o2prime"] or o2prime

        residue_regions: dict[tuple[str, str], list[dict]] = defaultdict(list)
        for (protein_token, region_id, _), value in frame_pairs.items():
            residue_regions[(protein_token, region_id)].append(value)

        for (protein_token, region_id), values in residue_regions.items():
            state_key = (protein_token, region_id)
            state = states.setdefault(
                state_key,
                {
                    "protein": values[0]["protein"],
                    "region_id": region_id,
                    "contact_frames": 0,
                    "distances": [],
                    "o2prime_frames": 0,
                    "contact_events": 0,
                    "current_run": 0,
                    "longest_run": 0,
                    "last_frame": None,
                    "nucleotide_counts": {},
                    "nucleotides": {},
                },
            )
            state["contact_frames"] += 1
            state["distances"].append(min(item["distance"] for item in values))
            state["o2prime_frames"] += int(any(item["o2prime"] for item in values))
            if state["last_frame"] is None or analyzed_frames != state["last_frame"] + 1:
                state["contact_events"] += 1
                state["current_run"] = 1
            else:
                state["current_run"] += 1
            state["longest_run"] = max(state["longest_run"], state["current_run"])
            state["last_frame"] = analyzed_frames
            for item in values:
                nucleotide_token = f"{item['nucleotide']['segid'] or '_'}:{item['nucleotide']['resid']}"
                state["nucleotide_counts"][nucleotide_token] = (
                    state["nucleotide_counts"].get(nucleotide_token, 0) + 1
                )
                state["nucleotides"][nucleotide_token] = item["nucleotide"]
        analyzed_frames += 1

    if analyzed_frames == 0:
        raise ValueError("trajectory contains no post-equilibration frames")
    fingerprints = []
    for state in states.values():
        fingerprints.append(
            {
                "protein": state["protein"],
                "region_id": state["region_id"],
                "contact_occupancy": state["contact_frames"] / analyzed_frames,
                "mean_contact_distance_A": float(np.mean(state["distances"])),
                "p10_contact_distance_A": float(np.percentile(state["distances"], 10)),
                "contact_events": state["contact_events"],
                "longest_run_frames": state["longest_run"],
                "o2prime_occupancy": state["o2prime_frames"] / analyzed_frames,
                "nucleotide_contacts": [
                    {
                        "nucleotide": state["nucleotides"][token],
                        "occupancy": count / analyzed_frames,
                    }
                    for token, count in sorted(state["nucleotide_counts"].items())
                ],
            }
        )
    fingerprints.sort(
        key=lambda item: (
            item["protein"]["segid"], item["protein"]["resid"], item["region_id"]
        )
    )
    frame_interval_ps = None
    try:
        frame_interval_ps = float(universe.trajectory.dt)
    except (TypeError, ValueError, AttributeError):
        pass
    return {
        "schema_version": 1,
        "config": config,
        "n_frames": analyzed_frames,
        "frame_interval_ps": frame_interval_ps,
        "source_label": source_label,
        "fingerprints": fingerprints,
        "provenance": {
            "generator": "StrandMD analyze.py",
            "mdanalysis_version": mda.__version__,
            "equilibration_start_frame": start,
            "occupancy_unit": "fraction_of_analyzed_frames",
            "distance_unit": "angstrom",
        },
    }


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--top", "--tpr", required=True, type=Path,
                    dest="top",
                    help="Topology (.gro preferred; .tpr or .pdb also OK)")
    ap.add_argument("--xtc", required=True, type=Path, help="Trajectory (.xtc / .trr)")
    ap.add_argument("-o", "--output", required=True, type=Path, help="Output dir for figures + JSON")
    ap.add_argument(
        "--engineering-config", type=Path,
        help="Optional engineering_config.json generated by StrandMD",
    )
    ap.add_argument(
        "--source-label", default="trajectory",
        help="Condition/run label stored in engineering.json",
    )
    args = ap.parse_args()

    args.output.mkdir(parents=True, exist_ok=True)
    figdir = args.output / "figures"
    figdir.mkdir(exist_ok=True)

    u = _load_universe(args.top, args.xtc)
    topology_index = _topology_index(u)
    topology_index_path = args.output / "topology_index.json"
    topology_index_path.write_text(json.dumps(topology_index, indent=2))
    n_frames = len(u.trajectory)
    equil_skip = int(n_frames * EQUIL_FRAC)
    print(f"Loaded {n_frames} frames; discarding first {equil_skip} ({EQUIL_FRAC*100:.0f}%) as equilibration.")

    results: dict[str, float | dict] = {
        "n_frames": n_frames,
        "equil_skip": equil_skip,
        "topology_index": topology_index_path.name,
    }

    # --- Protein Cα RMSD ---
    ref = u.copy()
    ref.trajectory[0]
    rmsd = rms.RMSD(u, ref, select="protein and name CA").run(verbose=False)
    time_ns = rmsd.results.rmsd[:, 1] / 1000.0
    values = rmsd.results.rmsd[:, 2]
    eq_mean = float(np.mean(values[equil_skip:])) if len(values) > equil_skip else float("nan")
    results["protein_rmsd_A"] = {"equilibrated_mean": eq_mean, "max": float(values.max())}
    np.savetxt(args.output / "rmsd.dat", np.column_stack([time_ns, values]), header="time_ns rmsd_A")
    fig, ax = plt.subplots(figsize=(8, 3))
    ax.plot(time_ns, values, lw=0.5)
    ax.set(xlabel="time (ns)", ylabel="RMSD (Å)", title="Protein Cα RMSD")
    fig.tight_layout()
    fig.savefig(figdir / "rmsd.png", dpi=120)
    plt.close(fig)

    # --- Protein Cα RMSF (per residue) ---
    align.AlignTraj(u, ref, select="protein and name CA", in_memory=True).run(verbose=False)
    ca = u.select_atoms("protein and name CA")
    rmsf = rms.RMSF(ca).run(start=equil_skip, verbose=False)
    results["protein_rmsf_A_mean"] = float(rmsf.results.rmsf.mean())
    np.savetxt(args.output / "rmsf.dat", np.column_stack([ca.resids, rmsf.results.rmsf]),
               header="resid rmsf_A")
    fig, ax = plt.subplots(figsize=(8, 3))
    ax.plot(ca.resids, rmsf.results.rmsf, lw=0.7)
    ax.set(xlabel="residue", ylabel="RMSF (Å)", title="Per-residue Cα RMSF")
    fig.tight_layout()
    fig.savefig(figdir / "rmsf.png", dpi=120)
    plt.close(fig)

    rmsf_by_residue = {
        f"{str(atom.segid or '_')}:{int(atom.resid)}": float(value)
        for atom, value in zip(ca, rmsf.results.rmsf)
    }

    # --- Radius of gyration ---
    rg = np.array([(ts.time / 1000.0, u.select_atoms("protein").radius_of_gyration())
                    for ts in u.trajectory])
    eq_rg = float(np.mean(rg[equil_skip:, 1])) if rg.shape[0] > equil_skip else float("nan")
    results["protein_rg_A"] = {"equilibrated_mean": eq_rg}
    np.savetxt(args.output / "rg.dat", rg, header="time_ns rg_A")
    fig, ax = plt.subplots(figsize=(8, 3))
    ax.plot(rg[:, 0], rg[:, 1], lw=0.5)
    ax.set(xlabel="time (ns)", ylabel="Rg (Å)", title="Protein radius of gyration")
    fig.tight_layout()
    fig.savefig(figdir / "rg.png", dpi=120)
    plt.close(fig)

    if args.engineering_config is not None:
        config = json.loads(args.engineering_config.read_text())
        engineering = _engineering_fingerprints(
            u, config, start=equil_skip, source_label=args.source_label
        )
        engineering["rmsf_by_residue"] = rmsf_by_residue
        engineering_path = args.output / "engineering.json"
        engineering_path.write_text(json.dumps(engineering, indent=2, default=str))
        results["engineering"] = {
            "enabled": True,
            "output": engineering_path.name,
            "fingerprint_count": len(engineering["fingerprints"]),
        }
        print(f"Wrote {engineering_path}")

    # --- Persistence write ---
    (args.output / "results.json").write_text(json.dumps(results, indent=2, default=str))
    print(f"Wrote {args.output / 'results.json'}")
    print(f"Wrote {topology_index_path}")
    print(f"Wrote figures in {figdir}/")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
